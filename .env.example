# ── Required ────────────────────────────────────────────────────────────────
# Anthropic key for research (web search), generation, revision, upload reading.
ANTHROPIC_API_KEY="sk-ant-..."
# Model the product calls. Override to a more powerful model for higher fidelity.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Optional (fast-follow integrations) ──────────────────────────────────────
# Public base URL, used to build the review link sent to Jaya.
APP_BASE_URL="http://localhost:3000"

# Slack: simplest path is an incoming webhook URL for the review ping.
SLACK_WEBHOOK_URL=""
# Or a bot token plus channel IDs for richer delivery.
SLACK_BOT_TOKEN=""
SLACK_REVIEW_CHANNEL=""
SLACK_ADVISOR_CHANNEL=""

# Protects the cron + generate endpoints when deployed.
CRON_SECRET=""

# Timezone used to label the upcoming week.
CONTENT_TIMEZONE="America/New_York"
